# Прокси same-origin через Cloudflare Pages Function (вариант B+).
# Оставь /api — фронт ходит на /api/*, CF-функция форвардит на swarm-api.
# (Можно указать прямой URL swarm-api для прямого режима без cookie-сессий.)
NEXT_PUBLIC_API_URL=/api

# Username бота для Telegram Login Widget (без @).
NEXT_PUBLIC_BOT_USERNAME=swarm_brain_bot

# true — мок-данные без бэкенда (локальная разработка UI).
NEXT_PUBLIC_DEV_MODE=false

# ── Переменные Cloudflare Pages (НЕ NEXT_PUBLIC — серверные, задать в дашборде CF) ──
# SWARM_API_URL=https://vbqglndbxkpmreccpqmr.supabase.co/functions/v1/swarm-api
# WEB_JWT_SECRET=<тот же, что в Supabase secrets>
# TELEGRAM_BOT_TOKEN=<тот же, что в Supabase secrets>
