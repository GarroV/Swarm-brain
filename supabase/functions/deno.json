{
  "tasks": {
    "test": "deno test -A"
  },
  "lock": false,

  // Ширина строки — 120, а не умолчательные 80. Замер 17.09.2026 на существующем коде:
  // 95-й процентиль длины строки 162 символа. С шириной 80 `deno fmt` переформатирует
  // любой тронутый файл целиком, и правка на три строки приходит диффом на триста —
  // то есть роль «формат» начинает мешать чтению вместо того, чтобы помогать.
  "fmt": {
    "lineWidth": 120
  },

  // https-импорты — канон этого репозитория: edge-функции деплоятся без карты импортов,
  // и bare-спецификатор рискует раскаткой. Правило `no-import-prefix` спорит именно с этим,
  // поэтому оно снимается один раз здесь, а не точечными `deno-lint-ignore` в каждом файле:
  // первый же блок стройки начал засорять ими код, и каждый следующий повторил бы.
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  }
}
