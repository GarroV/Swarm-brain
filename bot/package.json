{
  "name": "scriba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meeting-recording bot: joins a video call, records the mix and the speaker timeline, hands them to Swarm",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "deadcode": "knip",
    "boundaries": "depcruise src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "knip": "^6.35.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
