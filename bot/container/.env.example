# Переменные окружения контейнера scriba — ИМЕНА И БЕЗОПАСНЫЕ ЗНАЧЕНИЯ.
# Настоящие значения живут только в .env, который в .gitignore. Секретов здесь нет и быть
# не может: репозиторий публичный.
#
#   cp bot/container/.env.example bot/container/.env
#
# Блок container отвечает за окружение записи; переменные бота (токен, адрес сервера)
# добавят свои блоки — этот файл не единственный источник, а раздел про контейнер.

# ── Экран ──────────────────────────────────────────────────────────────────────────────
# Дисплей Xvfb. Chromium запускается в headed-режиме: headless чаще ломает звук.
DISPLAY=:99
# Размер виртуального экрана: ширина x высота x глубина цвета.
SCRIBA_SCREEN=1280x720x24

# ── Звук ───────────────────────────────────────────────────────────────────────────────
# Имя null-sink'а. Запись идёт с его monitor-source (<имя>.monitor).
SCRIBA_SINK_NAME=scriba
# Каталог сокетов PulseAudio. Без него демон разложит сокет там, где клиенты его не найдут.
XDG_RUNTIME_DIR=/run/user/1001

# ── Запись ─────────────────────────────────────────────────────────────────────────────
# Куда складывать части записи внутри контейнера.
SCRIBA_OUTPUT_DIR=/recordings
# Битрейт AAC, кбит/с. 32 — как у рекордера на речи; из него считается длина части под
# лимит 25 МБ у meeting-ingest.
SCRIBA_AUDIO_BITRATE_KBPS=32

# ── Ручки смоука записи (в бою не нужны) ───────────────────────────────────────────────
# Страница, которую открыть: по умолчанию звучащий тон.
SCRIBA_SMOKE_PAGE=file:///opt/scriba/tone.html
# Что считать успехом: sound (по умолчанию) или silence.
SCRIBA_SMOKE_EXPECT=sound
# Сколько секунд писать и какой длины делать части.
SCRIBA_SMOKE_SECONDS=9
SCRIBA_SMOKE_SEGMENT_SECONDS=3
# Историческая ручка. В smoke.sh больше не используется: живой прогон 2026-09-19
# показал, что в Playwright v1.63 на Linux `--mute-audio` в дефолтных аргументах
# Chromium нет, поэтому порча через FORCE_MUTE ничего не ломает. Оставлена как
# страховка на случай, если Playwright когда-нибудь добавит этот флаг обратно:
# smoke-audio.ts её всё ещё читает и передаёт `ignoreDefaultArgs: []`.
SCRIBA_SMOKE_FORCE_MUTE=0
