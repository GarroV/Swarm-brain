{
  "imports": {
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2",
    // Зависимости тестов доски инициатив: линт запрещает inline-адрес в импорте, и это по делу —
    // версия, размазанная по файлам, обновляется в одном месте и забывается в трёх остальных.
    "@std/assert": "https://deno.land/std@0.224.0/assert/mod.ts",
    "postgres": "https://deno.land/x/postgres@v0.19.3/mod.ts",
    // Алиас веба (его знают Vite/Next, но не Deno): без него type-check тестов miniapp падает
    // на первом же `@/types` и обрывает ВЕСЬ прогон до запуска тестов (issue #207).
    "@/": "./miniapp/src/"
  },
  // sloppy-imports — ради того же алиаса: веб пишет `@/types` без расширения (норма для
  // Vite/Next), Deno без этого флага требует `.ts` и обрывает прогон на type-check. Для
  // edge-функций ничего не меняет: там импорты и так с расширениями.
  "unstable": ["sloppy-imports"],
  // no-sloppy-imports выключен на весь репозиторий, и это не поблажка. Веб обязан писать
  // `@/types` без расширения — так его резолвит Next, а `@/types.ts` он не соберёт. Снять
  // правило точечной пометкой в файле нельзя: на свежем рантайме адрес резолвится чисто,
  // пометка становится НЕИСПОЛЬЗОВАННОЙ, и `ban-unused-ignore` роняет линт уже из-за неё.
  // Так гейт и покраснел в CI, оставаясь зелёным локально (Deno 2.8.3 против свежего).
  "lint": { "rules": { "exclude": ["no-sloppy-imports"] } },
  "tasks": {
    // Единая команда на весь репозиторий: edge-функции + тесты веба (у miniapp своего
    // раннера нет, тесты чистой логики гоняются здесь же). Флаг -A обязателен: часть тестов
    // установщика Claude Desktop пишет во временный каталог и запускает подпроцесс, и под
    // урезанными правами (--allow-read / --allow-net) они падают правами, а не по сути.
    "test": "deno test -A supabase/ miniapp/sw.test.ts miniapp/src/lib/"
  }
}
