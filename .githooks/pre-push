#!/usr/bin/env bash
# Два шага перед пушем (включается один раз на машине: git config core.hooksPath .githooks):
#   1) не пускает в публичный репозиторий детали незакрытых уязвимостей;
#   2) зовёт единую команду прогона scripts/check.
#
# Шаг 1 — не пускает в публичный репозиторий детали незакрытых уязвимостей.
#
# Повод (17.09.2026): внутренний трекер security-работ — перечень открытых дыр живого
# продукта с рабочими деталями — лежал в запушенной ветке и читался анонимно 12 дней.
# Репозиторий публичный, поэтому видна ЛЮБАЯ ветка, не только main.
#
# Документ, которому нельзя наружу, помечается внутри строкой-маркером (см. $MARKER —
# он собран из частей, иначе хук блокировал бы сам себя). Хранить такой файл вне git
# (~/Documents/workbench/private/), детали уязвимостей — в приватном advisory.
#
# Что проверяется: только коммиты, которых ещё нет ни в одной ветке на этом удалённом
# (`git rev-list <local> --not --remotes=<remote>` — тот же приём, что у git-lfs и у
# сторожей секретов). Коммит, уже достижимый из origin/*, публичен: пуш его не раскрывает.
# Раньше диапазон считался от удалённой ветки, и после слияния main в ветку хук стопорил
# пуш на старых коммитах main, давно публичных (issue #617).
#
# Осознанный обход: git push --no-verify
set -uo pipefail

REMOTE="${1:-origin}"   # git передаёт имя удалённого (или URL — тогда исключать нечего,
                        # и проверяется вся история ветки: ошибка в безопасную сторону)

ZERO='0000000000000000000000000000000000000000'
MARKER="PRIVATE-DO-NOT""-PUBLISH"
RISKY_NAME='(security[-_].*progress|.*security[-_]audit|.*pentest|.*vuln(erabilit)?(y|ies)[-_]|.*advisory[-_]draft)'

blocked=0
report() {
  if [ "$blocked" -eq 0 ]; then
    echo "" >&2
    echo "⛔ Пуш остановлен: в отправляемых коммитах есть внутренние security-материалы." >&2
    echo "   Репозиторий публичный — видны ВСЕ ветки, не только main." >&2
    echo "" >&2
  fi
  blocked=1
  echo "   • $1" >&2
}

has_update=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # удаление ветки — раскрывать нечего
  has_update=1

  # Новое = достижимо из local_sha, но не из веток удалённого и не из того, что уже
  # лежит в обновляемой ветке. remote_sha может отсутствовать локально (не сделан fetch) —
  # тогда исключаем только по --remotes: проверяется больше, а не меньше.
  revs=("$local_sha" --not "--remotes=$REMOTE")
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    revs+=("$remote_sha")
  fi

  # Ошибка git здесь — не «нечего проверять»: сторож закрывается, а не пропускает.
  if ! names=$(git log --name-only --pretty=format: "${revs[@]}" 2>/dev/null); then
    report "${_local_ref} — не удалось прочитать пушимые коммиты (git log упал)"
    continue
  fi
  files=$(printf '%s\n' "$names" | sort -u | sed '/^$/d')
  [ -z "$files" ] && continue

  # Ключи и токены в пушимых коммитах (.gitleaks.toml; тот же скан в CI — leak-scan.yml).
  # CI видит токен уже после пуша, а репозиторий публичный, поэтому ловим здесь. Нет
  # gitleaks — пуш стоит: молча пропущенный скан неотличим от чистого.
  if ! command -v gitleaks >/dev/null 2>&1; then
    report "gitleaks не установлен — brew install gitleaks"
  elif ! gitleaks git . --config "$(git rev-parse --show-toplevel)/.gitleaks.toml" \
      --log-opts="${revs[*]}" --redact --verbose --no-banner --log-level error >&2; then
    report "${_local_ref} — в пушимых коммитах похоже на ключ или токен (выше — где именно)"
  fi

  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in .githooks/*) continue ;; esac     # сама защита — не материал
    if printf '%s' "$f" | grep -qiE "$RISKY_NAME"; then
      report "$f — имя выглядит как внутренний security-документ"
      continue
    fi
    # Рабочий html владельца в корне (#465: так в main попала выгрузка доски с именами).
    # Ловим только живущий на вершине ветки файл — коммит, удаляющий такой, не держим.
    case "$f" in
      */*) ;;
      *.html)
        if git cat-file -e "$local_sha:$f" 2>/dev/null; then
          report "$f — рабочий html в корне репозитория; место ему в ~/Documents/workbench/private/"
          continue
        fi ;;
    esac
    # Маркер ищем по всем новым версиям файла: он мог быть добавлен и удалён внутри.
    # Без `git log | grep -q`: grep выходит на первом совпадении, git log получает SIGPIPE
    # (141), и под pipefail пайплайн «ложен» — маркер пропускался молча, если после
    # совпадения git log ещё писал (файл добавлен и удалён в пушимых коммитах).
    if ! patch=$(git log -p "${revs[@]}" -- "$f" 2>/dev/null); then
      report "$f — не удалось прочитать историю файла"
    elif printf '%s' "$patch" | grep -F -- "$MARKER" >/dev/null; then
      report "$f — помечен маркером запрета публикации"
    fi
  done <<< "$files"
done

if [ "$blocked" -eq 1 ]; then
  cat >&2 <<'TXT'

   Что делать:
   1. Держи файл вне git — ~/Documents/workbench/private/
   2. Детали уязвимости — в приватный advisory:
      gh api -X POST repos/{owner}/{repo}/security-advisories
   3. В публичном трекере оставь нейтральную строку: что делаем,
      без указания, чего именно не хватает и как это использовать.

   Файл уже в истории ветки? Удаления новым коммитом НЕ достаточно —
   перенеси работу на чистую ветку от main.

   Осознанно публикуешь? git push --no-verify

TXT
  exit 1
fi

# Шаг 2 — единая команда прогона. Пушатся одни удаления веток — проверять нечего:
# гейт на удаление висел минутами и не давал убрать пачку влитых веток (issue #664).
if [ "$has_update" -eq 0 ]; then
  echo "pre-push: только удаление веток — гейт не нужен"
  exit 0
fi

# Единая команда прогона. Хук ОБЯЗАН падать, когда инструмента нет, а не
# пропускать проверку молча: молчаливо пропущенный гейт неотличим от пройденного.
root="$(git rev-parse --show-toplevel)"

if [[ ! -x "$root/scripts/check" ]]; then
  echo "pre-push: $root/scripts/check отсутствует или не исполняемый — пуш остановлен." >&2
  echo "Это не повод обойти проверку: без единой команды прогона «зелено» ничего не значит." >&2
  exit 1
fi

# Режим fast — формат, линт, типы, мёртвый код, границы; без тестов и порчи (решение
# 01.10.2026, issues #595, #693). Тесты базы локально ходят в общий стенд на MUSPELHEIM, и
# параллельные сессии валили друг другу пре-пуш не по коду — пушили с --no-verify, то есть
# мимо и сторожа выше. Тесты и порча — в CI на чистой базе на каждый прогон; локально —
# `make test-db` и `scripts/check` без аргумента.
echo "pre-push: scripts/check fast (тесты и порча — в CI)"
exec "$root/scripts/check" fast
