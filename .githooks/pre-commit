#!/usr/bin/env bash
# Pre-commit: type-check Deno edge functions если затронут любой их .ts файл.
# Ловит регрессии вроде `.catch` на PromiseLike до того как красный код уйдёт в ветку.
# Обойти осознанно: git commit --no-verify
set -euo pipefail

# ── Doc-drift reminder (мягкое, НЕ блокирует) ────────────────────────────────────
# Правило (CLAUDE.md §2): доки — часть DoD, в ТОМ ЖЕ коммите. Менялся код в
# supabase/functions/ или miniapp/src/, но docs/ARCHITECTURE.md / QUICK_REF.md не
# тронуты → напоминаем свериться (чтобы находить «где что лежит»). Коммит продолжается.
all_staged=$(git diff --cached --name-only --diff-filter=ACM || true)
code_touched=$(echo "$all_staged" | grep -E '^(supabase/functions/|miniapp/src/).*\.(ts|tsx)$' | grep -v '\.test\.' || true)
docs_touched=$(echo "$all_staged" | grep -E '^docs/(ARCHITECTURE|QUICK_REF)\.md$' || true)
if [ -n "$code_touched" ] && [ -z "$docs_touched" ]; then
  echo "[pre-commit] 📝 напоминание: менялся код, но docs/ARCHITECTURE.md / QUICK_REF.md не тронуты." >&2
  echo "             Дока — часть DoD, в ТОМ ЖЕ коммите. Сверься; если не требуется — коммить дальше (не блокирует)." >&2
fi

staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^supabase/functions/.*\.ts$' || true)
if [ -z "$staged" ]; then
  exit 0
fi

if ! command -v deno >/dev/null 2>&1; then
  echo "[pre-commit] deno не найден — пропускаю type-check (установи deno)." >&2
  exit 0
fi

echo "[pre-commit] deno check edge functions…"
entrypoints=$(find supabase/functions -mindepth 2 -maxdepth 2 -name index.ts)

if ! deno check $entrypoints; then
  echo "" >&2
  echo "[pre-commit] ❌ type-check упал — коммит заблокирован." >&2
  echo "             Почини ошибки выше, либо 'git commit --no-verify' если осознанно." >&2
  exit 1
fi

echo "[pre-commit] ✅ type-check OK"
