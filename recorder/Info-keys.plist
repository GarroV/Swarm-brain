<?xml version="1.0" encoding="UTF-8"?>
<!--
  Справочник ключей Info.plist приложения SwarmRecorder. Фактический Info.plist собирает
  build-app.sh (эти ключи уже встроены) — Xcode не обязателен. Здесь — для наглядности.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- LSUIElement нет: с 23.10.2026 bumblebee — обычное приложение со значком в Dock и в ⌘Tab -->

  <!-- TCC usage descriptions (показываются в системном запросе разрешений) -->
  <key>NSMicrophoneUsageDescription</key>
  <string>SwarmRecorder записывает звук встречи, чтобы подготовить тезисы.</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>SwarmRecorder читает URL активной вкладки браузера, чтобы определить комнату звонка (Meet/Контур) для дедупа ad-hoc-встреч.</string>
  <!-- Запись экрана/системного звука (ScreenCaptureKit) отдельной Info-строки не требует:
       macOS сам запросит «Screen & System Audio Recording» в Privacy при первом запуске. -->
</dict>
</plist>
